<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_story_card_writer"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_story_card_writer_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StoryCardWriter">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".CharacterMemoActivity"
            android:exported="false"
            android:label="キャラクターメモ"
            android:theme="@style/Theme.StoryCardWriter"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".WriterActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.StoryCardWriter"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".OpenScwActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StoryCardWriter">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data
                    android:mimeType="application/vnd.storycardwriter+json"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data
                    android:host="*"
                    android:mimeType="application/json"
                    android:pathPattern=".*\\.scw"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data
                    android:host="*"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.scw"
                    android:scheme="content" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StoryCardWriter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
